# ---------------------------------------------------------------------------
# Supabase (client web app)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret the Expo artist app sends as `x-artist-secret`.
ARTIST_API_SECRET=generate-a-long-random-string

# ---------------------------------------------------------------------------
# YouCam AI Nail Transfer (server-only)
# ---------------------------------------------------------------------------
YOUCAM_API_KEY=your-youcam-api-key
YOUCAM_API_BASE_URL=https://s2s.ai.makeupar.com
YOUCAM_AI_NAIL_PATH=/s2s/v2.0/task/ai-nail
YOUCAM_POLL_INTERVAL_MS=1500
YOUCAM_POLL_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# LLM (style-aware design synthesis) — server-only
# ---------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
AI_TEMPERATURE=0.9

# ---------------------------------------------------------------------------
# Artist onboarding (MVP: seeded artist, used by the demo /confirm/[token] page)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_ARTIST_ID=00000000-0000-0000-0000-000000000000

# Image generation (optional)
# ---------------------------------------------------------------------------
# Provider for AI image generation: "gemini", "openai" or "placeholder"
IMAGE_PROVIDER=gemini

# ---------------------------------------------------------------------------
# Hackathon / offline demo: bypass YouCam and return a local fallback render.
# ---------------------------------------------------------------------------
MOCK_YOUCAM=false
