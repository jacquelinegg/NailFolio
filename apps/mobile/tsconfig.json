{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/lib/*": ["../../lib/*"],
      "@/services/*": ["../../services/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../lib/tags.ts",
    "../../lib/types.ts",
    "../../services/pricing.ts"
  ],
  "exclude": ["node_modules"]
}
