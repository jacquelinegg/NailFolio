# ---------------------------------------------------------------------------
# Artist app (Expo) — copy to apps/mobile/.env
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The Next.js web app hosting the artist API
#
# Optional for local development. When unset, the app derives the host from
# Metro's `hostUri`, so a physical device reaches your machine over the LAN and
# the Android emulator uses its 10.0.2.2 alias for the host loopback. Set this
# only to override that, e.g. a LAN IP that differs from the Metro host, or a
# deployed URL:
#   - Android emulator:  http://10.0.2.2:3000
#   - Physical device:   http://192.168.0.100:3000
#   - Production:        https://your-web-app.example.com
EXPO_PUBLIC_API_BASE_URL=https://your-web-app.example.com

# Must match ARTIST_API_SECRET in the web app's .env.local
EXPO_PUBLIC_ARTIST_API_SECRET=your-artist-api-secret

# The signed-in artist (auth arrives after the MVP)
EXPO_PUBLIC_ARTIST_ID=00000000-0000-0000-0000-000000000000
